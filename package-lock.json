{
  "name": "tapcue",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "tapcue",
      "version": "0.0.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.12"
      }
    },
    "node_modules/@tapcue/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@tapcue/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@tapcue/web": {
      "resolved": "packages/web",
      "link": true
    },
    "packages/server": {
      "name": "@tapcue/server",
      "version": "0.0.0",
      "dependencies": {
        "@tapcue/shared": "*"
      }
    },
    "packages/shared": {
      "name": "@tapcue/shared",
      "version": "0.0.0"
    },
    "packages/web": {
      "name": "@tapcue/web",
      "version": "0.0.0",
      "dependencies": {
        "@tapcue/shared": "*"
      }
    }
  }
}
